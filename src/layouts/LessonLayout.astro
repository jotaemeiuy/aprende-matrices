---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/Header/Header.astro";
import Footer from "../components/Footer/Footer.astro";
import ProgressCard from "../components/Progress/ProgressCard.astro";
import { modules } from "../data/modules.ts";
import "katex/dist/katex.min.css";

interface NavLink {
  title: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  moduleId: string;
  lessonSlug: string;
  kind: "teoria" | "practica";
  prev?: NavLink;
  next?: NavLink;
}

const { title, description, moduleId, lessonSlug, kind, prev, next } =
  Astro.props as Props;
const mod = modules.find((m) => m.id === moduleId);
const moduleTitle = mod?.title ?? moduleId;
const moduleNumber = mod?.number ?? "–";
const lessonSlugs = mod?.lessons.map((l) => l.slug) ?? [];
const lessonIndex = lessonSlugs.indexOf(lessonSlug);
---

<BaseLayout title={`${title} — Aprende Matrices`} description={description}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-20">
    <nav aria-label="Miga de pan" class="pt-8 text-sm text-zinc-500">
      <a href="/" class="hover:text-white">Inicio</a>
      <span aria-hidden="true" class="mx-2 text-zinc-700">/</span>
      <span class="text-zinc-300">{moduleTitle}</span>
    </nav>
    <p class="mt-6 inline-block rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-amber-300">
      {kind === "teoria" ? "Teoría" : "Práctica"}
    </p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
      {title}
    </h1>
    <p class="mt-3 text-lg text-zinc-400">{description}</p>
    <article class="lesson-content mt-8">
      <slot />
    </article>
    <nav
      aria-label="Anterior y siguiente"
      class="mt-12 flex items-center justify-between gap-4 border-t border-white/10 pt-6"
    >
      {
        prev ? (
          <a
            href={prev.href}
            data-astro-prefetch
            class="max-w-[45%] rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-zinc-300 hover:border-white/20 hover:text-white"
          >
            <span class="block text-xs text-zinc-500">← Anterior</span>
            <span class="block truncate">{prev.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a
            href={next.href}
            data-astro-prefetch
            class="max-w-[45%] rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-right text-sm text-zinc-300 hover:border-white/20 hover:text-white"
          >
            <span class="block text-xs text-zinc-500">Siguiente →</span>
            <span class="block truncate">{next.title}</span>
          </a>
        ) : (
          <a
            href="/"
            class="max-w-[45%] rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-right text-sm text-zinc-300 hover:border-white/20 hover:text-white"
          >
            <span class="block text-xs text-zinc-500">Temario</span>
            <span class="block truncate">Volver al inicio</span>
          </a>
        )
      }
    </nav>
  </main>
  <Footer />
  {
    lessonIndex >= 0 && (
      <ProgressCard
        moduleId={moduleId}
        moduleNumber={moduleNumber}
        moduleTitle={moduleTitle}
        lessonSlug={lessonSlug}
        lessonIndex={lessonIndex + 1}
        lessonTotal={lessonSlugs.length}
        lessonSlugs={lessonSlugs}
      />
    )
  }
</BaseLayout>

<style>
  .lesson-content > p {
    margin-block: 1rem;
    line-height: 1.75;
    color: var(--color-zinc-300);
  }
  .lesson-content > ul {
    margin-block: 1rem;
    padding-left: 1.5rem;
    list-style: disc;
    line-height: 1.75;
    color: var(--color-zinc-300);
  }
  .lesson-content > ol {
    margin-block: 1rem;
    padding-left: 1.5rem;
    list-style: decimal;
    line-height: 1.75;
    color: var(--color-zinc-300);
  }
  .lesson-content strong {
    color: var(--color-white);
  }
  .lesson-content .math-display {
    margin-block: 1.25rem;
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25rem;
  }
  .lesson-content pre {
    overflow-x: auto;
    border-radius: 0.75rem;
    margin-block: 1.25rem;
  }
</style>
