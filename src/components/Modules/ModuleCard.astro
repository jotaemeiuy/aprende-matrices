---
import Icon from "../icons/Icon.astro";
import LessonItem from "./LessonItem.astro";
import type { Module } from "../../data/modules.ts";

interface Props {
  module: Module;
}

const { module } = Astro.props as Props;
---
<article
  class="group/section relative overflow-hidden rounded-2xl border border-transparent px-5 py-5 transition-all duration-300 hover:border-amber-400/25 hover:bg-white/[0.06] hover:shadow-[0_0_40px_-12px_rgba(251,191,36,0.35)] focus-within:border-amber-400/25 focus-within:bg-white/[0.06]"
  aria-labelledby={`mod-${module.id}`}
>
  <span
    aria-hidden="true"
    class="pointer-events-none absolute top-2 right-4 select-none text-6xl font-black leading-none text-white/[0.06] transition-colors duration-500 group-hover/section:text-white/[0.12]"
  >
    {module.number}
  </span>
  <div class="flex items-start gap-3">
    <span class="mt-0.5 shrink-0 text-amber-400/50 transition-colors duration-300 group-hover/section:text-amber-400/80">
      <Icon name={module.icon} class="h-7 w-7" />
    </span>
    <div class="min-w-0 flex-1 pr-14">
      <h2 id={`mod-${module.id}`} class="text-[15px] font-bold text-amber-300">
        {module.title}
      </h2>
      <p class="mt-1 max-w-xs text-sm leading-relaxed text-zinc-500">
        {module.description}
      </p>
      <div
        data-module-progress={module.id}
        role="progressbar"
        aria-label={`Progreso de ${module.title}`}
        aria-valuemin={0}
        aria-valuemax={100}
        aria-valuenow={0}
        class="mt-2 max-w-xs"
      >
        <div class="h-1 overflow-hidden rounded-full bg-white/10">
          <div
            data-module-fill
            class="h-full w-0 rounded-full bg-amber-400"
          ></div>
        </div>
        <p class="mt-1 text-xs text-zinc-500">
          <span data-module-pct>0%</span> completado
        </p>
      </div>
    </div>
  </div>
  <ul class="mt-4 space-y-0.5 border-l border-transparent pl-9">
    {
      module.lessons.map((lesson) => (
        <LessonItem
          moduleId={module.id}
          slug={lesson.slug}
          title={lesson.title}
          kind={lesson.kind}
        />
      ))
    }
  </ul>
</article>
