---
interface Props {
  moduleId: string;
  moduleNumber: string;
  moduleTitle: string;
  lessonSlug: string;
  lessonIndex: number;
  lessonTotal: number;
  lessonSlugs: string[];
}

const {
  moduleId,
  moduleNumber,
  moduleTitle,
  lessonSlug,
  lessonIndex,
  lessonTotal,
  lessonSlugs,
} = Astro.props as Props;
---
<aside
  data-progress-card
  data-module-id={moduleId}
  data-lesson-slug={lessonSlug}
  data-slugs={JSON.stringify(lessonSlugs)}
  aria-label="Progreso del módulo"
  class="fixed bottom-4 left-4 z-40 w-52 rounded-2xl border border-white/10 bg-[#121218]/95 p-4 shadow-xl shadow-black/50 backdrop-blur"
>
  <div class="flex items-baseline justify-between gap-2">
    <span class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">
      Progreso
    </span>
    <span data-progress-pct class="text-sm font-bold text-amber-300">0%</span>
  </div>
  <div
    role="progressbar"
    aria-label={`Progreso de ${moduleTitle}`}
    aria-valuemin={0}
    aria-valuemax={100}
    aria-valuenow={0}
    data-progress-track
    class="mt-2 h-1.5 overflow-hidden rounded-full bg-white/10"
  >
    <div
      data-progress-fill
      class="h-full w-0 rounded-full bg-gradient-to-r from-amber-500 to-amber-300"
    ></div>
  </div>
  <p class="mt-3 text-[11px] uppercase tracking-wider text-zinc-500">
    Sección {moduleNumber}
  </p>
  <p class="text-[15px] font-bold leading-snug text-white">{moduleTitle}</p>
  <p class="mt-0.5 text-xs text-zinc-500">
    Lección {lessonIndex} de {lessonTotal}
  </p>
</aside>

<script>
  import { markVisited, modulePercent } from "../../lib/progress.ts";

  function initProgress(): void {
    const card = document.querySelector("[data-progress-card]");
    if (!(card instanceof HTMLElement)) return;
    const moduleId = card.dataset.moduleId ?? "";
    const lessonSlug = card.dataset.lessonSlug ?? "";
    const slugs = JSON.parse(card.dataset.slugs ?? "[]") as string[];
    if (moduleId === "" || lessonSlug === "") return;
    const state = markVisited(moduleId, lessonSlug);
    const pct = modulePercent(state.visited, moduleId, slugs);
    const pctEl = card.querySelector("[data-progress-pct]");
    const fillEl = card.querySelector("[data-progress-fill]");
    const trackEl = card.querySelector("[data-progress-track]");
    if (pctEl) pctEl.textContent = `${pct}%`;
    if (fillEl instanceof HTMLElement) fillEl.style.width = `${pct}%`;
    trackEl?.setAttribute("aria-valuenow", String(pct));
  }

  initProgress();
  document.addEventListener("astro:page-load", initProgress);
</script>
