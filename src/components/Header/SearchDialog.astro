---
import Icon from "../icons/Icon.astro";
---
<div class="w-full max-w-md">
  <button
    type="button"
    data-search-open
    class="flex w-full items-center gap-2 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-sm text-zinc-400 hover:border-white/20 hover:text-zinc-200"
    aria-label="Buscar clases (Ctrl K)"
  >
    <Icon name="search" class="h-4 w-4" />
    <span class="flex-1 text-left">Buscar clases...</span>
    <kbd class="rounded border border-white/10 bg-white/5 px-1.5 text-[11px] text-zinc-500">⌘</kbd>
    <kbd class="rounded border border-white/10 bg-white/5 px-1.5 text-[11px] text-zinc-500">K</kbd>
  </button>
</div>

<script>
  function initSearchTrigger(): void {
    const btn = document.querySelector("[data-search-open]");
    if (!(btn instanceof HTMLElement) || btn.dataset.wired === "1") return;
    btn.dataset.wired = "1";
    btn.addEventListener("click", (): void => {
      window.dispatchEvent(new CustomEvent("open-search"));
    });
  }

  initSearchTrigger();
  document.addEventListener("astro:page-load", initSearchTrigger);
</script>
