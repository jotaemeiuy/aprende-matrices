---
import Icon from "../icons/Icon.astro";
import { buildSearchIndex } from "../../lib/search.ts";
import type { SearchEntry } from "../../lib/search.ts";

const entries: SearchEntry[] = buildSearchIndex();
const payload: string = JSON.stringify(entries);
---
<div
  data-search-overlay
  class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-md"
  role="dialog"
  aria-modal="true"
  aria-label="Buscador de clases"
>
  <div class="mx-auto mt-[10vh] flex max-h-[80vh] w-[min(40rem,calc(100vw-2rem))] flex-col overflow-hidden rounded-xl border border-white/10 bg-[#121218] text-zinc-200 shadow-2xl shadow-black/50">
    <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3.5">
      <Icon name="search" class="h-4 w-4 shrink-0 text-zinc-500" />
      <input
        data-search-input
        type="text"
        placeholder="Buscar clases..."
        autocomplete="off"
        role="combobox"
        aria-expanded="true"
        aria-controls="search-list"
        aria-autocomplete="list"
        class="w-full bg-transparent text-[15px] text-white placeholder:text-zinc-500 focus:outline-none"
        aria-label="Buscar clases"
      />
      <span class="hidden shrink-0 items-center gap-1.5 sm:flex" aria-hidden="true">
        <kbd class="rounded-md border border-white/10 bg-white/5 px-1.5 py-0.5 text-[11px] text-zinc-500">↑</kbd>
        <kbd class="rounded-md border border-white/10 bg-white/5 px-1.5 py-0.5 text-[11px] text-zinc-500">↓</kbd>
        <kbd class="rounded-md border border-white/10 bg-white/5 px-1.5 py-0.5 text-[11px] text-zinc-500">Esc</kbd>
      </span>
    </div>
    <ul
      id="search-list"
      data-search-list
      role="listbox"
      aria-label="Resultados"
      class="overflow-y-auto p-2 [scrollbar-width:thin]"
    ></ul>
  </div>
</div>

<script type="application/json" data-search-index is:inline set:html={payload}></script>

<script>
  import type { SearchEntry } from "../../lib/search.ts";

  const indexEl = document.querySelector("[data-search-index]");
  const items: SearchEntry[] = JSON.parse(
    indexEl?.textContent ?? "[]",
  ) as SearchEntry[];
  let overlay: Element | null = null;
  let input: Element | null = null;
  let list: Element | null = null;

  let flatIds: string[] = [];
  let activeIndex = 0;
  let lastTrigger: HTMLElement | null = null;
  let wiredGlobal = false;

  function isOpen(): boolean {
    return (
      overlay instanceof HTMLElement && !overlay.classList.contains("hidden")
    );
  }

  function setActive(index: number): void {
    if (!(list instanceof HTMLElement) || flatIds.length === 0) return;
    activeIndex = (index + flatIds.length) % flatIds.length;
    const links = list.querySelectorAll("[data-result]");
    links.forEach((link) => {
      link.classList.remove("bg-white/10", "text-white");
      link.setAttribute("aria-selected", "false");
    });
    const activeId: string | undefined = flatIds[activeIndex];
    if (!activeId) return;
    const current = document.getElementById(activeId);
    current?.classList.add("bg-white/10", "text-white");
    current?.setAttribute("aria-selected", "true");
    current?.scrollIntoView({ block: "nearest" });
    if (input instanceof HTMLInputElement) {
      input.setAttribute("aria-activedescendant", activeId);
    }
  }

  function render(query: string): void {
    if (!(list instanceof HTMLElement)) return;
    const q = query.trim().toLowerCase();
    const found = items
      .filter(
        (e: SearchEntry): boolean =>
          q === "" ||
          e.title.toLowerCase().includes(q) ||
          e.moduleTitle.toLowerCase().includes(q),
      )
      .slice(0, 40);
    if (found.length === 0) {
      flatIds = [];
      list.innerHTML =
        '<li class="px-3 py-8 text-center text-sm text-zinc-500">Sin resultados</li>';
      return;
    }
    const groups: { moduleTitle: string; items: SearchEntry[] }[] = [];
    for (const e of found) {
      const last = groups[groups.length - 1];
      if (last && last.moduleTitle === e.moduleTitle) last.items.push(e);
      else groups.push({ moduleTitle: e.moduleTitle, items: [e] });
    }
    flatIds = found.map((_e, i) => `search-result-${i}`);
    let counter = 0;
    list.innerHTML = groups
      .map(
        (g) =>
          `<li class="px-3 pb-1 pt-3 text-[11px] font-bold uppercase tracking-wider text-amber-400" aria-hidden="true">${g.moduleTitle}</li>` +
          g.items
            .map((e) => {
              const id = `search-result-${counter}`;
              counter += 1;
              return (
                `<li role="option" aria-selected="false">` +
                `<a id="${id}" data-result data-astro-prefetch href="/clase/${e.moduleId}/${e.slug}" class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-[15px] text-zinc-300 hover:bg-white/5 hover:text-white">` +
                `<span>${e.title}</span>` +
                `<span class="text-zinc-600">›</span></a></li>`
              );
            })
            .join(""),
      )
      .join("");
    setActive(0);
  }

  function currentQuery(): string {
    return input instanceof HTMLInputElement ? input.value : "";
  }

  function openPalette(): void {
    if (!(overlay instanceof HTMLElement)) return;
    lastTrigger =
      document.activeElement instanceof HTMLElement
        ? document.activeElement
        : null;
    render(currentQuery());
    overlay.classList.remove("hidden");
    document.documentElement.style.overflow = "hidden";
    if (input instanceof HTMLInputElement) input.focus();
  }

  function closePalette(): void {
    if (!(overlay instanceof HTMLElement)) return;
    overlay.classList.add("hidden");
    document.documentElement.style.overflow = "";
    lastTrigger?.focus();
    lastTrigger = null;
  }

  function init(): void {
    overlay = document.querySelector("[data-search-overlay]");
    input = document.querySelector("[data-search-input]");
    list = document.querySelector("[data-search-list]");
    if (input instanceof HTMLElement && input.dataset.wired !== "1") {
      input.dataset.wired = "1";
      input.addEventListener("input", (ev: Event): void => {
        if (ev.target instanceof HTMLInputElement) render(ev.target.value);
      });
      input.addEventListener("keydown", (ev: Event): void => {
        if (!(ev instanceof KeyboardEvent)) return;
        if (ev.key === "ArrowDown") {
          ev.preventDefault();
          setActive(activeIndex + 1);
        } else if (ev.key === "ArrowUp") {
          ev.preventDefault();
          setActive(activeIndex - 1);
        } else if (ev.key === "Enter") {
          const activeId: string | undefined = flatIds[activeIndex];
          if (!activeId) return;
          const current = document.getElementById(activeId);
          if (current instanceof HTMLAnchorElement) {
            closePalette();
            current.click();
          }
        }
      });
    }
    if (overlay instanceof HTMLElement && overlay.dataset.wired !== "1") {
      overlay.dataset.wired = "1";
      overlay.addEventListener("click", (ev: Event): void => {
        if (ev.target === overlay) closePalette();
      });
    }
    if (list instanceof HTMLElement && list.dataset.wired !== "1") {
      list.dataset.wired = "1";
      list.addEventListener("click", (): void => {
        closePalette();
      });
    }
    if (!wiredGlobal) {
      wiredGlobal = true;
      window.addEventListener("open-search", (): void => {
        openPalette();
      });
      document.addEventListener("keydown", (ev: KeyboardEvent): void => {
        if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "k") {
          ev.preventDefault();
          openPalette();
        } else if (ev.key === "Escape" && isOpen()) {
          ev.preventDefault();
          closePalette();
        }
      });
      window.addEventListener("hashchange", (): void => {
        if (isOpen()) closePalette();
      });
    }
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
